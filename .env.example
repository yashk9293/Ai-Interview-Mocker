# Copy to .env and fill in. Never commit .env.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: no secrets there.

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk → Webhooks → endpoint for /api/webhooks/clerk, event user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Postgres connection string (Neon: Dashboard → Connection string)
DATABASE_URL=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Interview content
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
