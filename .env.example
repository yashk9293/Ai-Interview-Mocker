# Copy to .env and fill in. Never commit .env.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: no secrets there.

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: Clerk dashboard > API keys > JWT public key (PEM). Lets proxy.js verify
# sessions without a network call to Clerk on every request.
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk → Webhooks → endpoint for /api/webhooks/clerk, event user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Postgres connection string (Neon: Dashboard → Connection string)
DATABASE_URL=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: the live interview's voice.
# GEMINI_LIVE_VOICE=Kore

# Optional: a lip-synced avatar for the live interview (https://app.simli.com → API key,
# and a face from its gallery). Without these the live interview shows an animated orb.
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Interview content
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
